    <fields>
        <fullName>Rating_Indicator__c</fullName>
        <description>Coloured circle for the standard Rating (Hot = red, Warm = amber, Cold = green). Images come from the Apex_Rating_Indicators static resource so they render in Lightning list views, record pages and the highlights panel.</description>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Rating, &quot;Hot&quot;), IMAGE(&quot;/resource/Apex_Rating_Indicators/red.png&quot;, &quot;Hot&quot;, 16, 16), IF(ISPICKVAL(Rating, &quot;Warm&quot;), IMAGE(&quot;/resource/Apex_Rating_Indicators/amber.png&quot;, &quot;Warm&quot;, 16, 16), IF(ISPICKVAL(Rating, &quot;Cold&quot;), IMAGE(&quot;/resource/Apex_Rating_Indicators/green.png&quot;, &quot;Cold&quot;, 16, 16), &quot;&quot;)))</formula>
        <label>Rating Indicator</label>
        <type>Text</type>
    </fields>
