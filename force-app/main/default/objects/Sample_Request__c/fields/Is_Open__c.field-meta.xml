<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_Open__c</fullName>
    <externalId>false</externalId>
    <formula>NOT(OR(ISPICKVAL(Status__c, "Approved"), ISPICKVAL(Status__c, "Rejected"), ISPICKVAL(Status__c, "Closed")))</formula>
    <label>Is Open</label>
    <type>Checkbox</type>
</CustomField>
