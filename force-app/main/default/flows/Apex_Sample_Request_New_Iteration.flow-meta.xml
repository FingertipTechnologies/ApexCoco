    <description>Person 2. Quick action on Sample Request: creates the next iteration (same account, contact, opportunity and product) linked to this sample via Parent Sample Request. Used after a rejection so the opportunity continues instead of being lost.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_NextIteration</name>
        <dataType>Number</dataType>
        <expression>{!Get_Sample.Iteration_Number__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Apex New Sample Iteration {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Apex Sample Request - New Iteration</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Iteration</name>
        <label>Create next sample iteration</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignRecordIdToReference>varNewSampleId</assignRecordIdToReference>
        <connector>
            <targetReference>Get_New_Sample</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Screen</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>Get_Sample.Account__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contact__c</field>
            <value>
                <elementReference>Get_Sample.Contact__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Iteration_Number__c</field>
            <value>
                <elementReference>f_NextIteration</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Lead__c</field>
            <value>
                <elementReference>Get_Sample.Lead__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Notes__c</field>
            <value>
                <elementReference>Notes</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opportunity__c</field>
            <value>
                <elementReference>Get_Sample.Opportunity__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Parent_Sample_Request__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Product__c</field>
            <value>
                <elementReference>Get_Sample.Product__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Requested_Date__c</field>
            <value>
                <elementReference>f_Today</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Result__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sample_Quantity__c</field>
            <value>
                <elementReference>Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Sample_Unit__c</field>
            <value>
                <elementReference>Unit</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Specification__c</field>
            <value>
                <elementReference>Specification</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Requested</stringValue>
            </value>
        </inputAssignments>
        <object>Sample_Request__c</object>
    </recordCreates>
    <recordLookups>
        <name>Get_New_Sample</name>
        <label>Get new sample</label>
        <locationX>176</locationX>
        <locationY>470</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Confirmation_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varNewSampleId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Sample_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Sample</name>
        <label>Get current sample</label>
        <locationX>176</locationX>
        <locationY>110</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Iteration_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Sample_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Confirmation_Screen</name>
        <label>Iteration created</label>
        <locationX>176</locationX>
        <locationY>590</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Confirmation_Text</name>
            <fieldText>&lt;p&gt;&lt;b&gt;{!Get_New_Sample.Name}&lt;/b&gt; created as iteration {!Get_New_Sample.Iteration_Number__c} for the same opportunity. The opportunity remains open. Sales Admin will see it in the preparation queue.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Fault_Screen</name>
        <label>Something went wrong</label>
        <locationX>440</locationX>
        <locationY>470</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Fault_Text</name>
            <fieldText>&lt;p&gt;The iteration could not be created: {!$Flow.FaultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Iteration_Screen</name>
        <label>New sample iteration</label>
        <locationX>176</locationX>
        <locationY>230</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Create_Iteration</targetReference>
        </connector>
        <fields>
            <name>Intro_Text</name>
            <fieldText>&lt;p&gt;Creating iteration &lt;b&gt;{!f_NextIteration}&lt;/b&gt; of &lt;b&gt;{!Get_Sample.Product__r.Name}&lt;/b&gt; for &lt;b&gt;{!Get_Sample.Account__r.Name}&lt;/b&gt;. Previous result: {!Get_Sample.Result__c} {!Get_Sample.Rejection_Reason__c}. Adjust the specification the customer asked for.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Specification</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>Get_Sample.Specification__c</elementReference>
            </defaultValue>
            <fieldText>Revised specification / grade</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Quantity</name>
            <dataType>Number</dataType>
            <defaultValue>
                <elementReference>Get_Sample.Sample_Quantity__c</elementReference>
            </defaultValue>
            <fieldText>Sample quantity</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>2</scale>
        </fields>
        <fields>
            <name>Unit</name>
            <choiceReferences>Unit_KG</choiceReferences>
            <choiceReferences>Unit_G</choiceReferences>
            <choiceReferences>Unit_Other</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>Unit_KG</defaultSelectedChoiceReference>
            <fieldText>Sample unit</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Notes</name>
            <dataType>String</dataType>
            <fieldText>Notes for Sales Admin</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Sample</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varNewSampleId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
