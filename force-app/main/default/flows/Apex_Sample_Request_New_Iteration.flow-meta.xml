<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <choices>
        <name>Unit_G</name>
        <choiceText>G</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>G</stringValue>
        </value>
    </choices>
    <choices>
        <name>Unit_KG</name>
        <choiceText>KG</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>KG</stringValue>
        </value>
    </choices>
    <choices>
        <name>Unit_Other</name>
        <choiceText>Other</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Other</stringValue>
        </value>
