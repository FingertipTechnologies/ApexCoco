<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <decisions>
        <name>Reorder_Due</name>
        <label>Reorder due within the lead time?</label>
        <locationX>182</locationX>
        <locationY>230</locationY>
        <defaultConnectorLabel>Not yet</defaultConnectorLabel>
        <rules>
            <name>Due</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Expected_Reorder_Date__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>f_Threshold</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Open_Task</targetReference>
            </connector>
            <label>Due</label>
        </rules>
    </decisions>
    <decisions>
        <name>Repeat_Opportunity_Exists</name>
        <label>Open repeat opportunity exists?</label>
        <locationX>182</locationX>
        <locationY>830</locationY>
        <defaultConnector>
            <targetReference>Create_Repeat_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - create</defaultConnectorLabel>
        <rules>
            <name>Yes_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Repeat_Opportunity</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Task_Exists</name>
        <label>Open reorder task exists?</label>
        <locationX>182</locationX>
        <locationY>470</locationY>
        <defaultConnector>
            <targetReference>Create_Reorder_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - create</defaultConnectorLabel>
        <rules>
            <name>Yes_Task</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Task</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Repeat_Opportunity</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Person 2 repeat-business engine. Daily scheduled flow: for accounts whose Expected Reorder Date is within Apex Demo Setting.Reorder Lead Days (or overdue), create one follow-up task and one pre-filled Repeat opportunity (last product, last order value) if none is open. Reorder logic is DEMO / TO VALIDATE.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_CloseDate</name>
        <dataType>Date</dataType>
        <expression>IF({!$Record.Expected_Reorder_Date__c} &lt; TODAY(), TODAY() + 7, {!$Record.Expected_Reorder_Date__c})</expression>
    </formulas>
    <formulas>
        <name>f_OpportunityName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name} &amp; " - Repeat Order " &amp; TEXT(YEAR(TODAY())) &amp; "-" &amp; RIGHT("0" &amp; TEXT(MONTH(TODAY())), 2)</expression>
    </formulas>
    <formulas>
        <name>f_TaskSubject</name>
        <dataType>String</dataType>
        <expression>"Repeat order follow-up - " &amp; {!$Record.Name} &amp; " (expected " &amp; TEXT({!$Record.Expected_Reorder_Date__c}) &amp; ")"</expression>
    </formulas>
    <formulas>
        <name>f_Threshold</name>
        <dataType>Date</dataType>
        <expression>TODAY() + BLANKVALUE({!Get_Settings.Reorder_Lead_Days__c}, 15)</expression>
    </formulas>
    <formulas>
        <name>f_Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Apex Account Reorder Follow Up {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Apex Account - Reorder Follow-up (Scheduled)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
