                <stringValue>Customer is due to reorder based on their purchase cadence. Confirm quantity, supply period and price; a Repeat opportunity has been pre-filled.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
