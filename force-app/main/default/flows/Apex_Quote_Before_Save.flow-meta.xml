<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <assignments>
        <name>Apply_Defaults</name>
        <label>Apply defaults and approvers</label>
        <locationX>176</locationX>
        <locationY>590</locationY>
        <assignmentItems>
            <assignToReference>$Record.Quote_Version__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_Version</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Quote_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_QuoteDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Approval_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_ApprovalStatus</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Sales_Manager_Approver__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_SalesManagerApprover</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Management_Approver__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_ManagementApprover</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Management_Username</name>
        <label>Management approver username configured?</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Apply_Defaults</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - use manager chain</defaultConnectorLabel>
        <rules>
            <name>Configured</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Settings.Management_Approver_Username__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Management_User</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Person 2. Before-save on Quote: version 1 default, quote date default, Approval Status reset to Not Required when the discount no longer needs approval, and resolution of the two approver lookups used by the DEMO approval process (Sales Manager = owner's manager or the owner; Management = Apex Demo Setting username, else the manager's manager, else the sales manager approver).</description>
    <environments>Default</environments>
    <formulas>
        <name>f_ApprovalStatus</name>
        <dataType>String</dataType>
        <expression>IF(BLANKVALUE({!$Record.Discount}, 0) &lt;= BLANKVALUE({!Get_Settings.Discount_Threshold_Percent__c}, 5), "Not Required", IF(ISBLANK(TEXT({!$Record.Approval_Status__c})), "Not Required", TEXT({!$Record.Approval_Status__c})))</expression>
    </formulas>
    <formulas>
        <name>f_ManagementApprover</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Management_User.Id})), {!Get_Management_User.Id}, IF(NOT(ISBLANK({!Get_Owner.Manager.ManagerId})), {!Get_Owner.Manager.ManagerId}, {!f_SalesManagerApprover}))</expression>
    </formulas>
    <formulas>
        <name>f_QuoteDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!$Record.Quote_Date__c}), TODAY(), {!$Record.Quote_Date__c})</expression>
    </formulas>
    <formulas>
        <name>f_SalesManagerApprover</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Owner.ManagerId})), {!Get_Owner.ManagerId}, {!Get_Owner.Id})</expression>
    </formulas>
    <formulas>
        <name>f_Version</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!$Record.Quote_Version__c}) || {!$Record.Quote_Version__c} = 0, 1, {!$Record.Quote_Version__c})</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Apex Quote Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Apex Quote - Before Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Management_User</name>
        <label>Get management approver user</label>
        <locationX>50</locationX>
        <locationY>470</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Apply_Defaults</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Username</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Settings.Management_Approver_Username__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Owner</name>
        <label>Get quote owner</label>
        <locationX>176</locationX>
        <locationY>110</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Settings</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Settings</name>
        <label>Get Apex Demo Settings</label>
        <locationX>176</locationX>
        <locationY>230</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Management_Username</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Apex_Demo_Setting__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Owner</targetReference>
        </connector>
        <object>Quote</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
