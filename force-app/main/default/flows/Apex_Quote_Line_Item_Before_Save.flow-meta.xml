<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <assignments>
        <name>Apply_Values</name>
        <label>Apply account, cost and price history</label>
        <locationX>176</locationX>
        <locationY>230</locationY>
        <assignmentItems>
            <assignToReference>$Record.Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Quote.AccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Unit_Cost__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_UnitCost</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Line_Cost__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_LineCost</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Last_Quoted_Price__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_LastPrice</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Last_Quoted_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_LastDate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Person 2 pricing history. Before-save on Quote Line Item: stamps the Account (for per-customer price history reports), defaults Unit Cost from the product's DEMO standard cost, computes Line Cost for the quote margin roll-up, and looks up the last price quoted to the same customer for the same product.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_LastDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!Get_Previous_Line.Id}), {!$Record.Last_Quoted_Date__c}, {!Get_Previous_Line.Quote.Quote_Date__c})</expression>
    </formulas>
    <formulas>
        <name>f_LastPrice</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!Get_Previous_Line.Id}), {!$Record.Last_Quoted_Price__c}, {!Get_Previous_Line.UnitPrice})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>f_LineCost</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!f_UnitCost}, 0) * BLANKVALUE({!$Record.Quantity}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>f_UnitCost</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!$Record.Unit_Cost__c}), {!$Record.Product2.Standard_Cost__c}, {!$Record.Unit_Cost__c})</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Apex Quote Line Item Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Apex Quote Line Item - Before Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Previous_Line</name>
        <label>Get last quoted line for this customer and product</label>
        <locationX>176</locationX>
        <locationY>110</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Apply_Values</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Quote.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Product2Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Product2Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>QuoteId</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.QuoteId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>QuoteLineItem</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Previous_Line</targetReference>
        </connector>
        <object>QuoteLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
