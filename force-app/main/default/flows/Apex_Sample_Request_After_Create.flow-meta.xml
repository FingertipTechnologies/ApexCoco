    <recordLookups>
        <name>Get_All_Samples</name>
        <label>Get all samples for the opportunity</label>
        <locationX>314</locationX>
        <locationY>830</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
