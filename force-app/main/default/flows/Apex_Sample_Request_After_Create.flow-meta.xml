    <customErrors>
        <name>Fault_Error</name>
        <label>Show fault</label>
        <locationX>842</locationX>
        <locationY>950</locationY>
        <customErrorMessages>
            <errorMessage>Apex sample automation could not complete: {!$Flow.FaultMessage}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Existing_Opportunity_Found</name>
        <label>Existing active opportunity found?</label>
        <locationX>182</locationX>
        <locationY>470</locationY>
        <defaultConnector>
            <targetReference>Create_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - create opportunity</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Opportunity</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Existing_Opportunity</targetReference>
            </connector>
            <label>Yes - link to it</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Opportunity</name>
        <label>Sample already linked to an opportunity?</label>
        <locationX>380</locationX>
        <locationY>230</locationY>
        <defaultConnector>
            <targetReference>Get_Existing_Opportunity</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Linked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Opportunity__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Linked_Opportunity</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Person 2. When a Sample Request is created: link it to the active Opportunity for the same Account and Product, or create the Opportunity at Stage = Sample Requested (a sample request is Apex's real buying signal). Never creates a duplicate opportunity. Updates the opportunity sample summary and creates the preparation task.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_CloseDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + BLANKVALUE({!Get_Settings.Default_Close_Days__c}, 90)</expression>
    </formulas>
    <formulas>
        <name>f_LatestSampleStatus</name>
        <dataType>String</dataType>
        <expression>"Sample #" &amp; TEXT({!$Record.Iteration_Number__c}) &amp; " (" &amp; {!$Record.Name} &amp; ") - " &amp; TEXT({!$Record.Status__c})</expression>
    </formulas>
    <formulas>
        <name>f_OpportunityName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Account__r.Name} &amp; " - " &amp; {!$Record.Product__r.Name}</expression>
    </formulas>
    <formulas>
        <name>f_TaskDueDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 2</expression>
    </formulas>
    <formulas>
        <name>f_TaskSubject</name>
        <dataType>String</dataType>
        <expression>"Prepare sample " &amp; {!$Record.Name} &amp; " - " &amp; {!$Record.Product__r.Name} &amp; " for " &amp; {!$Record.Account__r.Name}</expression>
    </formulas>
    <interviewLabel>Apex Sample Request After Create {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Apex Sample Request - After Create</label>
    <processMetadataValues>
        <name>BuilderType</name>
