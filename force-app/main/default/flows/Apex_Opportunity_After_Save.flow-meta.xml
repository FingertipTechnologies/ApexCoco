    <decisions>
        <name>Stage_Changed_To</name>
        <label>Which stage was just reached?</label>
        <locationX>710</locationX>
        <locationY>110</locationY>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>Quotation_Sent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Quotation Sent</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Quotation Sent</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Quote_Follow_Up_Task</targetReference>
            </connector>
            <label>Quotation Sent</label>
        </rules>
        <rules>
            <name>Customer_Approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer Approval</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Customer Approval</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Onboarding</targetReference>
            </connector>
            <label>Customer Approval</label>
        </rules>
        <rules>
            <name>PO_Received_Or_Won</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>PO Received</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Won</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.StageName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Order</targetReference>
            </connector>
            <label>PO Received / Closed Won</label>
        </rules>
        <rules>
            <name>Closed_Lost</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed Lost</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Reengagement_Task</targetReference>
            </connector>
            <label>Closed Lost</label>
        </rules>
    </decisions>
    <description>Person 2. Stage automation on Opportunity: Quotation Sent creates a quote follow-up task; Customer Approval creates the onboarding checklist and task; PO Received (or Closed Won) creates the Salesforce Order with the PO details and an order product priced from the latest quote line (fallback: price book); Closed Lost creates a re-engagement task in 90 days so the relationship is kept.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_OnboardingDue</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 14</expression>
    </formulas>
    <formulas>
        <name>f_OrderDescription</name>
        <dataType>String</dataType>
        <expression>"Created from opportunity " &amp; {!$Record.Name} &amp; " on receipt of PO " &amp; {!$Record.PO_Number__c} &amp; ". SAP handoff via Send to SAP (simulated)."</expression>
    </formulas>
    <formulas>
        <name>f_OrderQuantity</name>
        <dataType>Number</dataType>
        <expression>IF(BLANKVALUE({!$Record.PO_Quantity__c}, 0) &gt; 0, {!$Record.PO_Quantity__c}, 1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>f_QuoteFollowUp</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 5</expression>
    </formulas>
    <formulas>
        <name>f_ReengagementDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 90</expression>
    </formulas>
    <formulas>
        <name>f_ReengagementSubject</name>
        <dataType>String</dataType>
        <expression>"Re-engage " &amp; {!$Record.Account.Name} &amp; " (lost: " &amp; TEXT({!$Record.Loss_Reason__c}) &amp; ")"</expression>
    </formulas>
    <formulas>
        <name>f_UnitPrice</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!Get_Latest_Quote_Line.UnitPrice}), {!Get_Pricebook_Entry.UnitPrice}, {!Get_Latest_Quote_Line.UnitPrice})</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Apex Opportunity After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Apex Opportunity - After Save (Stage Automation)</label>
