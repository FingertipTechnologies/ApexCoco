    <description>Person 2. After a Sample Request is updated: keep the opportunity sample summary current; Dispatched moves an opportunity from Sample Requested to Sample Testing; Customer Testing creates the feedback follow-up task; Approved sets the Sample Approved Date, advances the opportunity to Sample Approved, creates the technical-evaluation task and notifies the owner; Rejected keeps the opportunity OPEN, records the next action on it, creates the next-iteration task and notifies the owner.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_ApprovedStage</name>
        <dataType>String</dataType>
        <expression>IF(OR(ISPICKVAL({!$Record.Opportunity__r.StageName}, "Sample Requested"), ISPICKVAL({!$Record.Opportunity__r.StageName}, "Sample Testing")), "Sample Approved", TEXT({!$Record.Opportunity__r.StageName}))</expression>
    </formulas>
    <formulas>
        <name>f_ApprovedBody</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name} &amp; " (" &amp; {!$Record.Product__r.Name} &amp; ", iteration " &amp; TEXT({!$Record.Iteration_Number__c}) &amp; ") was approved by " &amp; {!$Record.Account__r.Name} &amp; ". Opportunity moved to Sample Approved. Next: technical evaluation."</expression>
    </formulas>
    <formulas>
        <name>f_ApprovalDate</name>
        <dataType>Date</dataType>
        <expression>BLANKVALUE({!$Record.Approval_Date__c}, TODAY())</expression>
    </formulas>
    <formulas>
        <name>f_FeedbackDue</name>
        <dataType>Date</dataType>
        <expression>BLANKVALUE({!$Record.Feedback_Due_Date__c}, TODAY() + 7)</expression>
    </formulas>
    <formulas>
        <name>f_LatestSampleStatus</name>
        <dataType>String</dataType>
        <expression>"Sample #" &amp; TEXT({!$Record.Iteration_Number__c}) &amp; " (" &amp; {!$Record.Name} &amp; ") - " &amp; TEXT({!$Record.Status__c}) &amp; IF(ISPICKVAL({!$Record.Result__c}, "Rejected"), " - " &amp; TEXT({!$Record.Rejection_Reason__c}), "")</expression>
    </formulas>
    <formulas>
        <name>f_NextActionDate</name>
        <dataType>Date</dataType>
        <expression>BLANKVALUE({!$Record.Next_Action_Date__c}, TODAY() + 3)</expression>
    </formulas>
    <formulas>
        <name>f_NextIteration</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Iteration_Number__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_RejectedBody</name>
        <dataType>String</dataType>
        <expression>{!$Record.Name} &amp; " (" &amp; {!$Record.Product__r.Name} &amp; ", iteration " &amp; TEXT({!$Record.Iteration_Number__c}) &amp; ") was rejected: " &amp; TEXT({!$Record.Rejection_Reason__c}) &amp; ". The opportunity remains open. Next action: " &amp; {!$Record.Next_Action__c}</expression>
    </formulas>
    <formulas>
        <name>f_RejectedTaskSubject</name>
        <dataType>String</dataType>
        <expression>"Agree revised specification and send sample #" &amp; TEXT({!$Record.Iteration_Number__c} + 1) &amp; " - " &amp; {!$Record.Account__r.Name}</expression>
    </formulas>
    <formulas>
        <name>f_TechEvalSubject</name>
        <dataType>String</dataType>
        <expression>"Schedule technical evaluation - " &amp; {!$Record.Account__r.Name} &amp; " / " &amp; {!$Record.Product__r.Name}</expression>
    </formulas>
    <formulas>
        <name>f_FeedbackSubject</name>
        <dataType>String</dataType>
        <expression>"Follow up on sample feedback " &amp; {!$Record.Name} &amp; " - " &amp; {!$Record.Account__r.Name}</expression>
    </formulas>
    <interviewLabel>Apex Sample Request After Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Apex Sample Request - After Update</label>
