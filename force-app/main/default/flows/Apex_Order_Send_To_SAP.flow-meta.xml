        </value>
    </choices>
    <description>DEMO ONLY - Person 2. Simulated Salesforce -&gt; SAP order handoff. Writes an outbound Integration Log with the payload summary, then writes the simulated inbound response (SAP sales order number, status, invoice number when Invoiced) to the Order and a second log entry. No real SAP connection: the real integration (middleware, retries, monitoring) is Phase 2.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_InvoiceNumber</name>
        <dataType>String</dataType>
        <expression>IF({!Simulated_Status} = "Invoiced", "90" &amp; RIGHT({!Get_Order.OrderNumber}, 6), {!Get_Order.SAP_Invoice_Number__c})</expression>
    </formulas>
    <formulas>
        <name>f_LineText</name>
        <dataType>String</dataType>
        <expression>{!Loop_Items.Product2.Name} &amp; " | qty " &amp; TEXT({!Loop_Items.Quantity}) &amp; " | unit price " &amp; TEXT({!Loop_Items.UnitPrice}) &amp; " | total " &amp; TEXT({!Loop_Items.TotalPrice}) &amp; BR()</expression>
    </formulas>
    <formulas>
        <name>f_Now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>f_PayloadSummary</name>
        <dataType>String</dataType>
        <expression>"SIMULATED SAP PAYLOAD (DEMO)" &amp; BR() &amp; "Order: " &amp; {!Get_Order.OrderNumber} &amp; BR() &amp; "Customer: " &amp; {!Get_Order.Account.Name} &amp; BR() &amp; "PO: " &amp; {!Get_Order.PoNumber} &amp; " dated " &amp; TEXT({!Get_Order.PoDate}) &amp; BR() &amp; "Order date: " &amp; TEXT({!Get_Order.EffectiveDate}) &amp; BR() &amp; "Total: " &amp; TEXT({!Get_Order.TotalAmount}) &amp; BR() &amp; "Lines (product | qty | unit price | total):" &amp; BR() &amp; {!varPayloadText}</expression>
    </formulas>
    <formulas>
        <name>f_ResponseSummary</name>
        <dataType>String</dataType>
        <expression>"SIMULATED SAP RESPONSE (DEMO)" &amp; BR() &amp; "SAP Sales Order: " &amp; {!f_SapOrderNumber} &amp; BR() &amp; "Status: " &amp; {!Simulated_Status} &amp; IF({!Simulated_Status} = "Invoiced", BR() &amp; "Invoice: " &amp; {!f_InvoiceNumber}, "")</expression>
    </formulas>
    <formulas>
        <name>f_SapOrderNumber</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Order.SAP_Order_Number__c}), "45" &amp; RIGHT({!Get_Order.OrderNumber}, 6), {!Get_Order.SAP_Order_Number__c})</expression>
    </formulas>
    <interviewLabel>Apex Send to SAP (Simulated) {!$Flow.CurrentDateTime}</interviewLabel>
