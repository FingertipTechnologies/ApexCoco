    <description>Person 2 quote revisions. Quick action on Quote: creates version n+1 as a new Quote (same opportunity, terms and lines, with an optional new unit price and line discount; the quote-level Discount is calculated from the lines), links it to this version via Previous Quote, and marks this version Revised. Every version is kept for price history.</description>
    <environments>Default</environments>
    <formulas>
        <name>f_NewDiscount</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!New_Discount}), BLANKVALUE({!Loop_Lines.Discount}, 0), {!New_Discount})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>f_NewUnitPrice</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!New_Unit_Price}) || {!New_Unit_Price} = 0, {!Loop_Lines.UnitPrice}, {!New_Unit_Price})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>f_NextVersion</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!Get_Quote.Quote_Version__c}, 1) + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Apex Revise Quote {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Apex Quote - Revise (New Version)</label>
