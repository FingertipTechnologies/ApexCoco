# ---------------------------------------------------------------------------
# ApexCoco - Scan Visiting Card demo
# Copy to .env.local and fill in what you need. Everything is optional: with no
# variables set the demo runs fully offline against an in-memory Salesforce.
# ---------------------------------------------------------------------------

# OCR provider: "tesseract" (default, runs locally) | "none"
OCR_PROVIDER=tesseract

# When set, POST /api/extract requires this value in the x-api-key header.
# Store the same value as the password of the Salesforce Named Credential
# "Visiting Card OCR" so the Apex adapter can call this service.
# OCR_SERVICE_API_KEY=change-me

# AI parsing: set a key to enable Claude-based structured extraction.
# Without it the deterministic heuristic parser is used.
# ANTHROPIC_API_KEY=sk-ant-...
# EXTRACTION_MODEL=claude-opus-5-5

# Salesforce backend: "mock" (default, in-memory) | "jsforce" (real org)
SALESFORCE_PROVIDER=mock

# Seed the mock org with an existing "Fingertip" Account + Contact so the
# "Potential Existing Customer Found" path can be demoed. true | false
SALESFORCE_MOCK_SEED_EXISTING=false

# Real org (only when SALESFORCE_PROVIDER=jsforce). Username/password flow.
# SALESFORCE_LOGIN_URL=https://login.salesforce.com
# SALESFORCE_USERNAME=
# SALESFORCE_PASSWORD=
# SALESFORCE_SECURITY_TOKEN=
